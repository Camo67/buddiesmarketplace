# Copy this file to .env.server on the VPS and replace all placeholder secrets.

MYSQL_ROOT_PASSWORD=replace-with-a-long-root-password
MYSQL_DATABASE=buddies_app
MYSQL_USER=buddies
MYSQL_PASSWORD=replace-with-a-long-app-password

DATABASE_URL=mysql://buddies:replace-with-a-long-app-password@127.0.0.1:3306/buddies_app
APP_DB_PROVIDER=mysql
APP_DB_HOST=127.0.0.1
APP_DB_PORT=3306
APP_DB_NAME=buddies_app
APP_DB_USER=buddies
APP_DB_PASSWORD=replace-with-a-long-app-password
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGINS=https://buddiesworldwide.online,https://www.buddiesworldwide.online
APP_BASE_URL=https://buddiesworldwide.online
APP_BASE_URL_ALIASES=https://www.buddiesworldwide.online,https://app.buddiesworldwide.online
APP_SESSION_SECRET=replace-with-a-random-session-secret-at-least-32-characters
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_ADMIN_EMAILS=moderator@your-domain.example
SUPABASE_ADMIN_ROLE=buddies-admin

EMAIL_VERIFIER_API_KEY=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=ZAR

META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

CLOUDFLARE_TUNNEL_TOKEN=replace-with-a-remotely-managed-tunnel-token
