# Copy these values into cPanel Application Manager environment variables
# or into .env.production.local inside the application root.

APP_DB_PROVIDER=mysql
APP_DB_HOST=localhost
APP_DB_PORT=3306
APP_DB_NAME=cpaneluser_buddies_app
APP_DB_USER=cpaneluser_buddies
APP_DB_PASSWORD=replace-with-your-database-password

APP_BASE_URL=https://your-domain.example
# If you also serve the app on a second hostname, list it here.
APP_BASE_URL_ALIASES=https://www.your-domain.example
APP_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_ADMIN_EMAILS=moderator@your-domain.example
SUPABASE_ADMIN_ROLE=buddies-admin

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=ZAR

META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
