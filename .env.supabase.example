# Copy these values into .env.production.local or your deployment provider environment settings.
# This switches both the marketplace data layer and app auth to Supabase.

APP_DB_PROVIDER=postgres
APP_DB_URL=postgresql://postgres:replace-with-your-db-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

APP_BASE_URL=https://your-app.example
APP_BASE_URL_ALIASES=
APP_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_ADMIN_EMAILS=moderator@your-domain.example
SUPABASE_ADMIN_ROLE=buddies-admin

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=ZAR

SUPABASE_SERVICE_ROLE_KEY=
