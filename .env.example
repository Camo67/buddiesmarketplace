MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=buddies_app
MYSQL_USER=buddies
MYSQL_PASSWORD=buddies123

APP_DB_PROVIDER=mysql
APP_DB_HOST=127.0.0.1
APP_DB_PORT=3306
APP_DB_NAME=buddies_app
APP_DB_USER=buddies
APP_DB_PASSWORD=buddies123

# Use https://app.buddiesworldwide.online when running behind the Cloudflare preview tunnel.
APP_BASE_URL=http://localhost:3000
# Optional comma-separated aliases that should keep their own host during auth flows.
APP_BASE_URL_ALIASES=
APP_SESSION_SECRET=buddies-local-session-secret-change-me-1234567890

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_ADMIN_EMAILS=moderator@example.com
SUPABASE_ADMIN_ROLE=buddies-admin

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=ZAR

# Optional: only needed when starting the preview tunnel profile in docker compose.
CLOUDFLARE_TUNNEL_TOKEN=
