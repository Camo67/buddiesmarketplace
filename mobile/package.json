{
  "name": "buddiesworldwide-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "prebuild": "expo prebuild --platform all --no-install",
    "build:android:preview": "npx eas-cli build -p android --profile preview",
    "build:ios:preview": "npx eas-cli build -p ios --profile preview",
    "build:android:production": "npx eas-cli build -p android --profile production",
    "build:ios:production": "npx eas-cli build -p ios --profile production"
  },
  "dependencies": {
    "expo": "~55.0.8",
    "expo-constants": "~55.0.9",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.10",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
